generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  locationId   String   @id @default(cuid()) @map("Location_ID")
  locationName String?  @map("Location_name")
  devices      Device[]

  @@map("LOCATION")
}

model User {
  userId        String         @id @default(cuid()) @map("User_ID")
  username      String         @unique @map("Username")
  email         String         @unique @map("Email")
  password      String         @map("Password")
  firstName     String?        @map("F_name")
  lastName      String?        @map("L_name")
  role          Role           @default(CUSTOMER) @map("Role")
  createdAt     DateTime       @default(now()) @map("Created_at")
  admin         Admin?
  customer      Customer?
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@map("USER")
}

model Customer {
  userId    String     @id @map("User_ID")
  adminId   String?    @map("Customer_AdminID")
  actuators Actuator[]
  admin     Admin?     @relation("AdminManagesCustomer", fields: [adminId], references: [userId])
  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reports   Report[]
  requests  Request[]  @relation("CustomerRequests")
  schedules Schedule[]

  @@index([adminId])
  @@map("CUSTOMER")
}

model Admin {
  userId    String     @id @map("User_ID")
  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  customers Customer[] @relation("AdminManagesCustomer")
  requests  Request[]  @relation("AdminHandlesRequest")

  @@map("ADMIN")
}

model Device {
  deviceId      String         @id @default(cuid()) @map("Device_ID")
  serial        String         @unique @map("Serial")
  deviceName    String?        @map("Device_name")
  status        DeviceStatus?  @map("Status")
  deviceType    DeviceType?    @map("Device_type")
  locationId    String?        @map("Device_LocationID")
  tbDeviceId    String         @map("TB_Device_ID")
  actuator      Actuator?
  location      Location?      @relation(fields: [locationId], references: [locationId])
  notifications Notification[]
  requests      Request[]
  sensor        Sensor?

  @@index([locationId])
  @@index([serial])
  @@map("DEVICE")
}

model Actuator {
  deviceId   String     @id @map("Device_ID")
  customerId String?    @map("Actuator_CustomerID")
  customer   Customer?  @relation(fields: [customerId], references: [userId])
  device     Device     @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  schedules  Schedule[]

  @@index([customerId])
  @@map("ACTUATOR")
}

model Sensor {
  deviceId    String        @id @map("Device_ID")
  unit        String?       @map("Unit")
  threshold   Float?        @map("Threshold")
  data        Data[]
  device      Device        @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  summaryData SummaryData[]

  @@map("SENSOR")
}

model Data {
  timestamp DateTime @map("Time_stamp")
  sensorId  String   @map("Sensor_ID")
  dataType  DataType @map("Data_type")
  value     Float?   @map("Value")
  sensor    Sensor   @relation(fields: [sensorId], references: [deviceId], onDelete: Cascade)

  @@id([timestamp, sensorId, dataType])
  @@index([sensorId, timestamp])
  @@map("DATA")
}

model Notification {
  notiId    String   @id @default(cuid()) @map("Noti_ID")
  title     String?  @map("Title")
  content   String?  @map("Content")
  isRead    Boolean  @default(false) @map("Is_read")
  createdAt DateTime @default(now()) @map("Created_at")
  userId    String   @map("Noti_UserID")
  deviceId  String?  @map("Noti_DeviceID")
  device    Device?  @relation(fields: [deviceId], references: [deviceId])
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([userId, isRead])
  @@map("NOTIFICATION")
}

model Request {
  requestId   String         @id @default(cuid()) @map("Request_ID")
  content     String?        @map("Content")
  requestType RequestType?   @map("Request_type")
  status      RequestStatus? @map("Status")
  createdAt   DateTime       @default(now()) @map("Created_at")
  note        String?        @map("Note")
  serial      String?        @map("Serial")
  deviceId    String?        @map("Request_DeviceID")
  customerId  String?        @map("Request_UserID")
  adminId     String?        @map("Request_AdminID")
  admin       Admin?         @relation("AdminHandlesRequest", fields: [adminId], references: [userId])
  device      Device?        @relation(fields: [deviceId], references: [deviceId])
  customer    Customer?      @relation("CustomerRequests", fields: [customerId], references: [userId])

  @@index([customerId])
  @@index([adminId])
  @@index([deviceId])
  @@index([status, createdAt])
  @@map("REQUEST")
}

model Schedule {
  scheduleId String     @id @default(cuid()) @map("Schedule_ID")
  duration   Int?       @map("Duration")
  action     String?    @map("Action")
  frequency  Frequency? @map("Frequency")
  startTime  DateTime?  @map("Start_time")
  customerId String     @map("Sched_UserID")
  actuatorId String     @map("Sched_DeviceID")
  actuator   Actuator   @relation(fields: [actuatorId], references: [deviceId])
  customer   Customer   @relation(fields: [customerId], references: [userId])

  @@index([customerId])
  @@index([actuatorId])
  @@map("SCHEDULE")
}

model Report {
  reportId    String        @id @default(cuid()) @map("Report_ID")
  reportType  ReportType?   @map("Report_type")
  createdAt   DateTime      @default(now()) @map("Created_at")
  startTime   DateTime?     @map("Start_time")
  endTime     DateTime?     @map("End_time")
  customerId  String        @map("Report_UserID")
  customer    Customer      @relation(fields: [customerId], references: [userId])
  summaryData SummaryData[]

  @@index([customerId])
  @@map("REPORT")
}

model SummaryData {
  metricName String @map("Metric_name")
  reportId   String @map("Report_ID")
  sensorId   String @map("Sensor_ID")
  value      Float? @map("Value")
  report     Report @relation(fields: [reportId], references: [reportId], onDelete: Cascade)
  sensor     Sensor @relation(fields: [sensorId], references: [deviceId])

  @@id([metricName, reportId])
  @@index([sensorId])
  @@index([reportId])
  @@map("SUMMARY_DATA")
}

model RefreshToken {
  id        String   @id @default(cuid()) @map("ID")
  token     String   @unique @map("Token")
  userId    String   @map("User_ID")
  createdAt DateTime @default(now()) @map("Created_at")
  expiresAt DateTime @map("Expires_at")
  revoked   Boolean  @default(false) @map("Revoked")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("REFRESH_TOKEN")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum DeviceType {
  SENSOR
  ACTUATOR
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DISCONNECTED
}

enum Frequency {
  ONCE
  DAILY
  WEEKLY
}

enum DataType {
  TEMPERATURE
  HUMIDITY
  GAS
}

enum RequestType {
  ADD
  UPDATE
  DELETE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
}
